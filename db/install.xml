<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/examdates/db" VERSION="2026090304" COMMENT="Exam and assignment dates plugin">
  <TABLES>
    <TABLE NAME="local_examdates_log" COMMENT="Log of assessment activity date changes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true"/>
        <FIELD NAME="course_fullname" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="modulename" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="quiz"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"/>
        <FIELD NAME="activity_name" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true"/>
        <FIELD NAME="quiz_name" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="idnumber" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="old_timeopen" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="old_timeclose" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="new_timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="new_timeclose" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="extra_data" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="action_type" TYPE="char" LENGTH="20" NOTNULL="false" DEFAULT="bulk"/>
        <FIELD NAME="batch_id" TYPE="char" LENGTH="40" NOTNULL="false"/>
        <FIELD NAME="ip_address" TYPE="char" LENGTH="45" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="quizid_idx" UNIQUE="false" FIELDS="quizid"/>
        <INDEX NAME="activity_idx" UNIQUE="false" FIELDS="modulename,instanceid"/>
        <INDEX NAME="categoryid_idx" UNIQUE="false" FIELDS="categoryid"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="batchid_idx" UNIQUE="false" FIELDS="batch_id"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>